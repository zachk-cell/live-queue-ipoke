# ── Copy this file to ".env" and fill in the values you have. ──
# You can run the whole app with NONE of these set (simulator mode).

# Web server port
PORT=3000

# ── CONTROL PANEL SECURITY ──
# Password to open the private control panel (buyer names, totals, buttons).
# The public buyer view (/public) needs no password and shows no sensitive data.
PANEL_PASSWORD=change-this-to-something-strong
# Optional: a long random string to keep logins valid across restarts.
# If left blank, a new one is generated each boot (everyone re-logs in after a restart).
SESSION_SECRET=

# ── DEMO / SIMULATOR ──
# true = generate fake orders so you can see the queue work without TikTok.
SIMULATE=true
# milliseconds between simulated orders (2500 = fast demo; ~60000 = realistic)
SIM_INTERVAL_MS=2500

# ── TIKTOK SHOP (turn on after authorizing your shop to the app) ──
TIKTOK_ENABLED=false
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Filled in automatically after authorizing (also seedable here so the app can
# refresh on boot). ACCESS token is short-lived; REFRESH is the durable seed.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
# The Partner Center authorization link (used by the panel's "Reconnect" button).
TIKTOK_AUTH_URL=
# How often to poll for new orders while live (ms).
TIKTOK_POLL_MS=10000
# usually leave these defaults:
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_API_VERSION=202309

# ── DISCORD MIRROR (optional) ──
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ══════════════════════════════════════════════════════════════════════════
# iPoke STORE ONLY — perpetual, Shopify-sourced queue with events/side-queues.
# Leave all of this unset/false for the TikTok stores (PBCC, Poke Pig).
# ══════════════════════════════════════════════════════════════════════════

# Perpetual queue: never turns off, ingests 24/7 (incl. while the stream is
# offline). Hides the Go Live button and sets iPoke's combining behaviour.
PERPETUAL=true

# Order combining (iPoke default = "untiltop"): a buyer's repeat orders combine
# into their slot WHILE it hasn't reached the top yet; once the slot has been at
# the top (bag being packed), a new order does NOT merge — it takes its own
# position and the top slot flashes a "they ordered again" indicator. No toggle,
# no time limit — leave COMBINE_MODE unset to use this. (Advanced/optional
# overrides: off | time | always; 'time' also uses COMBINE_WINDOW_MINUTES.)
# COMBINE_MODE=untiltop
# COMBINE_WINDOW_MINUTES=30

# ── SHOPIFY (iPoke order source) ──
# Turn on once the store's custom app + Admin API token exist.
SHOPIFY_ENABLED=false
# Store domain, e.g. your-store.myshopify.com (no https://).
SHOPIFY_SHOP=
# Admin API access token from the store's custom app (read_orders + read_customers,
# with Protected Customer Data access approved). The USER pastes this in Render —
# it is a secret and must never be committed.
SHOPIFY_ADMIN_TOKEN=
# Usually leave these defaults:
SHOPIFY_API_VERSION=2025-01
SHOPIFY_POLL_MS=10000
# On boot, look back this many minutes to catch orders placed during a redeploy
# gap (ingest is idempotent, so re-fetching is safe). Default 360 when PERPETUAL.
SHOPIFY_BOOT_LOOKBACK_MIN=360

# OBS overlay: add a Browser Source pointing at  https://<your-app>/overlay
# Optional query params: ?rows=12  ?side=left|right  ?scale=1.2  ?bg=0  ?title=...
